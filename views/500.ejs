<%- include('./partials/header', { activePage: '', title: 'Ошибка сервера' }) %>

<main id="main">
  <section class="error-page">
    <div class="container">
      <div class="error-code">500</div>
      <h1>Что-то пошло не так</h1>
      <p>На сервере произошла ошибка. Мы уже работаем над ней — попробуйте обновить страницу позже.</p>
      <% if (typeof error !== 'undefined' && error) { %>
        <p class="text-muted" style="margin-top: 0.75rem;"><%= error %></p>
      <% } %>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">
          <i class="fa-solid fa-house"></i> На главную
        </a>
        <a href="/contacts" class="btn btn-secondary">Связаться с нами</a>
      </div>
    </div>
  </section>
</main>

<%- include('./partials/footer') %>
