<%- include('./partials/header', { activePage: 'contacts', title: 'Контакты' }) %>

<section class="page-hero">
  <div class="container">
    <div class="breadcrumbs">Главная / Контакты</div>
    <h1>Контакты</h1>
  </div>
</section>

<section class="section">
  <div class="container contact-layout">
    <div class="info-stack">
      <div class="contact-card">
        <h3>Наши данные</h3>
        <p><strong>Адрес:</strong> <%= settings.address %></p>
        <p><strong>Телефон:</strong> <%= settings.phone %></p>
        <p><strong>Email:</strong> <%= settings.email %></p>
        <p><strong>Режим работы:</strong> <%= settings.workHours %></p>
      </div>

      <div class="contact-card">
        <h3>Карта</h3>
        <div class="map"><%- settings.mapEmbed || '' %></div>
      </div>
    </div>

    <div class="contact-card">
      <h3>Написать нам</h3>
      <form data-form="order">
        <div class="form-grid">
          <div class="form-row">
            <div>
              <label>Имя</label>
              <input name="name" required />
            </div>
            <div>
              <label>Телефон</label>
              <input name="phone" required />
            </div>
          </div>

          <div>
            <label>Email</label>
            <input name="email" type="email" />
          </div>
          <div>
            <label>Услуга</label>
            <input id="order-service" name="service" />
          </div>
          <div>
            <label>Сообщение</label>
            <textarea name="message" id="order-message"></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Отправить</button>
          <div id="order-status"></div>
        </div>
      </form>
    </div>
  </div>
</section>

<%- include('./partials/footer') %>
