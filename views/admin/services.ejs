<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container navbar">
        <a href="/admin" class="brand">
          <span class="brand-mark">P</span>
          <span>Admin Panel</span>
        </a>

        <div class="theme-picker" aria-label="Выбор темы админки">
          <span class="theme-label">Тема оформления</span>
          <div class="theme-switcher">
            <button class="theme-btn active" type="button" data-theme-option="classic" aria-label="Классическая тема"></button>
            <button class="theme-btn" type="button" data-theme-option="dark" aria-label="Тёмная тема"></button>
            <button class="theme-btn" type="button" data-theme-option="forest" aria-label="Лесная тема"></button>
            <button class="theme-btn" type="button" data-theme-option="sunset" aria-label="Закатная тема"></button>
          </div>
        </div>

        <form method="POST" action="/admin/logout">
          <button type="submit" class="btn btn-secondary">Выход</button>
        </form>
      </div>
    </header>

    <div class="container admin-shell">
      <aside class="sidebar">
        <a href="/admin">Дашборд</a>
        <a href="/admin/services" class="active">Услуги</a>
        <a href="/admin/gallery">Галерея</a>
        <a href="/admin/orders">Заявки</a>
        <a href="/admin/settings">Настройки</a>
      </aside>

      <main class="admin-content">
        <%- include('../partials/flash') %>
        <div class="admin-card">
          <div class="section-head">
            <h2>Услуги</h2>
            <a href="/admin/services/new" class="btn btn-primary">Добавить услугу</a>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Название</th>
                  <th>Цена</th>
                  <th>Порядок</th>
                  <th>Активна</th>
                  <th>Действия</th>
                </tr>
              </thead>
              <tbody>
                <% services.forEach((service) => { %>
                  <tr>
                    <td><%= service.title %></td>
                    <td><%= service.price %> ₽</td>
                    <td><%= service.order %></td>
                    <td><%= service.isActive ? 'Да' : 'Нет' %></td>
                    <td>
                      <a href="/admin/services/<%= service.id %>/edit" class="btn btn-secondary">Редактировать</a>
                      <form method="POST" action="/admin/services/<%= service.id %>/delete" style="display:inline;">
                        <button type="submit" class="btn btn-primary">Удалить</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
    <script src="/js/main.js"></script>
  </body>
</html>
